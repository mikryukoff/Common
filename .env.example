PROJECT_NAME=App
VERSION=0.1.0
ENVIRONMENT=development

# Compose project name (изолирует контейнеры/сети между проектами)
COMPOSE_PROJECT_NAME=app

# Compose: db. Локальный uvicorn без Docker: localhost
DB_HOST=db
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

LOGS_OUTPUT_PATH=data/logs
DATA_BASE_PATH=data
UPLOADS_PATH=data/uploads

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_CHANGE_PASSWORD_SECRET=change-me-change-password-secret
FILE_ENCRYPTION_KEY=insecure-dev-key

JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_CHANGE_PASSWORD_TTL_MIN=10

LOGIN_ATTEMPTS_LIMIT=5
LOGIN_WINDOW_MIN=15
LOGIN_BLOCK_MIN=30

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345!
BOOTSTRAP_ADMIN_ROLE=admin
BOOTSTRAP_ADMIN_IS_ACTIVE=true
BOOTSTRAP_ADMIN_RESET_PASSWORD_ON_START=true

FORCE_RELOGIN_ON_RESTART=true
ALLOW_PASSWORD_GENERATOR_ENDPOINT=true
TEMP_PASSWORD_LEN=12

RUN_MIGRATIONS=true
LOG_BODY_ENABLED=false
LOG_VERBOSE_HTTP=false
